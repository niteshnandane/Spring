<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="in.sp.beans.Student" id="stdId">
        <property name="name" value="nitesh" />
        <property name="rollno" value="101" />
        <property name="email" value="nitesh@gmail.com" />
    </bean>


    <bean class="in.sp.beans.Student" id="stdId2">
        <property name="name" value="bhavini" />
        <property name="rollno" value="102" />
        <property name="email" value="bhavini@gmail.com" />
    </bean>

</beans>